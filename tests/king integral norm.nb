Cell[BoxData[
 RowBox[{
  RowBox[{"n", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox[
       RowBox[{"x", "^", "2"}], 
       RowBox[{"2", " ", "\[Beta]", " ", 
        RowBox[{"\[Alpha]", "^", "2"}]}]]}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"-", "\[Beta]"}], ")"}]}], 
   RowBox[{"Sin", "[", "x", "]"}]}]}]], "Input",
