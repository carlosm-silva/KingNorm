Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"b", "=", "1"}], ",", 
   RowBox[{"b", "<", "4"}], ",", 
   RowBox[{"b", "++"}], ",", "\n", 
   RowBox[{
    RowBox[{"ares", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"n", "[", 
        RowBox[{"\[Alpha]", ",", "b", ",", "x"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ">", "0"}], "}"}]}]}], "]"}]}], ";", "\n", "\t", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"a", "=", "1"}], ",", 
      RowBox[{"a", "<=", "10"}], ",", 
      RowBox[{"a", "++"}], ",", "\n", "\t\t", 
      RowBox[{
       RowBox[{"nres", " ", "=", " ", 
        RowBox[{"Re", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"ares", "/.", 
            RowBox[{"{", 
             RowBox[{"\[Alpha]", "->", 
              RowBox[{"1", "/", "a"}]}], "}"}]}], ",", "50"}], "]"}], "]"}]}],
        ";", "\n", "\t\t", 
       RowBox[{"Print", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"1", "/", "a"}], ",", "50"}], "]"}], ",", "b", ",", 
          "nres"}], "}"}], "]"}]}]}], "\n", "\t", "]"}]}]}], "\n", 
